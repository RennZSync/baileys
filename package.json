{
  "name": "@rennzsync/baileys",
  "type": "module",
  "version": "10.2.3",
  "description": "renz/baileys — WhatsApp Multi-Device library rebased @whiskeysockets/baileys 7.0.0-rc14, using the original libsignal (GPL-3.0) Signal Protocol engine. Maintained by RennZz-Dev. Focus: multimedia WhatsApp bots, low RAM footprint.",
  "license": "MIT",
  "author": "RennZz-Dev (https://github.com/renzxhub)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RennZSync/baileys.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*"
  ],
  "scripts": {
    "build:proto": "pbjs -t static-module -w es6 -o WAProto/index.js WAProto/WAProto.proto && pbts -o WAProto/index.d.ts WAProto/index.js && node WAProto/fix-imports.js",
    "build": "npm run build:proto",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "renz",
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "multi-device",
    "bot",
    "automation",
    "multimedia"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "link-preview-js": "^5.0.0",
    "protobufjs-cli": "^1.1.3"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "cache-manager": "^7.0.0",
    "jimp": "^1.6.0",
    "link-preview-js": "^5.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "cache-manager": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
